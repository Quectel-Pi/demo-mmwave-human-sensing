diff --git a/kernel/include/uapi/linux/r60abd1.h b/kernel/include/uapi/linux/r60abd1.h
new file mode 100644
--- /dev/null
+++ b/kernel/include/uapi/linux/r60abd1.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_R60ABD1_H
+#define _UAPI_LINUX_R60ABD1_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define R60ABD1_VERSION 1
+#define R60ABD1_MAX_PAYLOAD 4087
+#define R60ABD1_MAX_VALUES 12
+#define R60ABD1_DEVICE "/dev/r60abd1"
+
+enum r60abd1_mode {
+	R60ABD1_REALTIME = 0,
+	R60ABD1_SLEEP = 1,
+	R60ABD1_UNKNOWN = 255,
+};
+
+enum r60abd1_type {
+	R60ABD1_HEARTBEAT = 1,
+	R60ABD1_RESET,
+	R60ABD1_READY,
+	R60ABD1_MODEL,
+	R60ABD1_PRODUCT_ID,
+	R60ABD1_HARDWARE,
+	R60ABD1_FIRMWARE,
+	R60ABD1_RANGE,
+	R60ABD1_PRESENCE,
+	R60ABD1_MOTION,
+	R60ABD1_AMPLITUDE,
+	R60ABD1_DISTANCE,
+	R60ABD1_POSITION,
+	R60ABD1_RESP_STATUS,
+	R60ABD1_RESP_RATE,
+	R60ABD1_RESP_WAVE,
+	R60ABD1_HEART_RATE,
+	R60ABD1_HEART_WAVE,
+	R60ABD1_BED,
+	R60ABD1_STAGE,
+	R60ABD1_AWAKE_TIME,
+	R60ABD1_LIGHT_TIME,
+	R60ABD1_DEEP_TIME,
+	R60ABD1_SCORE,
+	R60ABD1_SUMMARY,
+	R60ABD1_ANALYSIS,
+	R60ABD1_SLEEP_ERROR,
+	R60ABD1_QUALITY,
+	R60ABD1_STRUGGLE,
+	R60ABD1_ABSENCE,
+	R60ABD1_RAW,
+	R60ABD1_MODE,
+	R60ABD1_PROTOCOL_ERROR,
+};
+
+struct r60abd1_event {
+	__u32 version;
+	__u32 type;
+	__u32 mode;
+	__u32 count;
+	__aligned_u64 received_ns;
+	__u32 length;
+	__u32 error;
+	__s32 value[R60ABD1_MAX_VALUES];
+	__u8 control;
+	__u8 command;
+	__u8 reserved[6];
+	__u8 raw[R60ABD1_MAX_PAYLOAD + 1];
+};
+
+struct r60abd1_status {
+	__u32 version;
+	__u32 event_size;
+	__u32 mode;
+	__u32 ready;
+	__u32 queued;
+	__u32 capacity;
+	__u32 connected;
+	__u32 reserved;
+	__aligned_u64 bytes;
+	__aligned_u64 frames;
+	__aligned_u64 errors;
+	__aligned_u64 dropped;
+};
+
+struct r60abd1_mode_arg {
+	__u32 mode;
+	__u32 timeout_ms;
+};
+
+struct r60abd1_state_arg {
+	__u32 type;
+	__u32 timeout_ms;
+	__s32 value;
+	__u32 mode;
+	__aligned_u64 received_ns;
+};
+
+struct r60abd1_monitor_arg {
+	__u32 control;
+	__u32 timeout_ms;
+};
+
+struct r60abd1_query_arg {
+	__u32 control;
+	__u32 command;
+};
+
+#define R60ABD1_GET_MODE _IOWR('R', 1, struct r60abd1_mode_arg)
+#define R60ABD1_SET_MODE _IOW('R', 2, struct r60abd1_mode_arg)
+#define R60ABD1_GET_STATUS _IOR('R', 3, struct r60abd1_status)
+#define R60ABD1_GET_STATE _IOWR('R', 4, struct r60abd1_state_arg)
+#define R60ABD1_ENABLE_MONITOR _IOW('R', 5, struct r60abd1_monitor_arg)
+#define R60ABD1_QUERY _IOW('R', 6, struct r60abd1_query_arg)
+
+#endif
